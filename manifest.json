{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "version": "2.2.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-pomodoro": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdOpenPomodoro__"
    },
    "toggle-timer": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "__MSG_cmdToggleTimer__"
    }
  },
  "incognito": "spanning", 
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "blockpage.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["blockpage.html"],
      "matches": ["<all_urls>"]
    }
  ]
}