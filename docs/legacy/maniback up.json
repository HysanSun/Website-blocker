{
    "manifest_version": 3,
    "name": "Website Blocker",
    "version": "1.5",
    "description": "A strict focus tool to help you remove any distraction and remain high productivity",
    "permissions": [
      "declarativeNetRequest",
      "storage"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "action": {
      "default_popup": "blockpage.html",
      "default_icon": "icon.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "declarative_net_request": {
      "rule_resources": []
    }
  }